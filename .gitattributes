# Normalise text files to LF in the repository and check them out with the
# platform's native line endings.
* text=auto

*.md   text eol=lf
*.cs   text eol=lf
*.csproj text eol=lf
*.sln  text eol=lf
*.xaml text eol=lf
*.ps1  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.iss  text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.pdb  binary
