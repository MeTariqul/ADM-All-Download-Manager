<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Adm.App</RootNamespace>
    <AssemblyName>ADM</AssemblyName>
    <Product>ADM All Download Manager</Product>
    <AssemblyTitle>ADM All Download Manager</AssemblyTitle>
    <Version>1.2.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADM.Core\ADM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the notification-area icon can be loaded at runtime. -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
