<Window x:Class="Adm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Adm.App.Converters"
        Title="ADM — All Download Manager"
        Width="1160" Height="740" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Closing="OnWindowClosing">

    <Window.Resources>
        <conv:CategoryGlyphConverter x:Key="CategoryGlyph" />
        <conv:StatusBrushConverter x:Key="StatusBrush" />

        <Style x:Key="RowProgress" TargetType="ProgressBar" BasedOn="{StaticResource SlimProgressBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Queued">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Header / quick add -->
        <Grid Grid.Row="0" Margin="28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="↓" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ADM" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="All Download Manager" FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Height="40" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox x:Name="AddUrlBox"
                                 Style="{StaticResource InputBox}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12.5"
                                 Padding="13,8"
                                 Text="{Binding AddUrlText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddBoxKeyDown" />
                        <TextBlock Text="Paste a download link..."
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AddUrlText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="1" Content="Add" Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="3"
                            Padding="16,6" FontSize="12" />
                </Grid>
            </Border>

            <Button Grid.Column="2" Content="&#xE713;" Style="{StaticResource IconButton}"
                    Width="34" Height="34" FontSize="14" Margin="10,0,0,0"
                    AutomationProperties.Name="Settings"
                    ToolTip="Settings" Click="OnSettingsClick" />
        </Grid>

        <!-- Library + downloads -->
        <Grid Grid.Row="1" Margin="28,4,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,4,20,0">
                <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CategoryButton}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Downloads" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ItemCount}" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="9,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="190" Height="30" VerticalAlignment="Center" Margin="0,0,12,0"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource InputBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="12"
                                         Padding="10,4"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Search downloads..."
                                           Margin="11,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Button Content="Pause all" Style="{StaticResource GhostButton}"
                                Command="{Binding PauseAllCommand}" Margin="0,0,6,0" />
                        <Button Content="Resume all" Style="{StaticResource GhostButton}"
                                Command="{Binding ResumeAllCommand}" Margin="0,0,6,0" />
                        <Button Content="Clear completed" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearCompletedCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="DownloadList" ItemsSource="{Binding DownloadsView}" Style="{StaticResource DownloadList}"
                             SelectionMode="Extended" SelectionChanged="OnSelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pause" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <MenuItem Header="Resume" Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <MenuItem Header="Restart" Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Separator />
                                <MenuItem Header="Move to top" Command="{Binding DataContext.MoveToTopCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <MenuItem Header="Copy link" Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <MenuItem Header="Options..." Command="{Binding DataContext.ShowOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Separator />
                                <MenuItem Header="Open file" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <MenuItem Header="Show in folder" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Separator />
                                <MenuItem Header="Remove" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="6,14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="32" Height="32" CornerRadius="7"
                                                Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}"
                                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}" FontSize="11.5"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                         Style="{StaticResource RowProgress}" Margin="0,9,0,0"
                                                         Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#xE769;" Style="{StaticResource IconButton}"
                                                    AutomationProperties.Name="Pause"
                                                    ToolTip="Pause"
                                                    Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="&#xE768;" Style="{StaticResource IconButton}"
                                                    AutomationProperties.Name="Resume"
                                                    ToolTip="Resume"
                                                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="&#xE8A7;" Style="{StaticResource IconButton}"
                                                    AutomationProperties.Name="Open file"
                                                    ToolTip="Open file"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="&#xE8B7;" Style="{StaticResource IconButton}"
                                                    AutomationProperties.Name="Show in folder"
                                                    ToolTip="Show in folder"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="&#xE74D;" Style="{StaticResource DangerIconButton}"
                                                    AutomationProperties.Name="Remove"
                                                    ToolTip="Remove"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="46" Height="46" CornerRadius="23"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock Text="↓" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <TextBlock Text="No downloads yet" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="Paste a link above, or send one from your browser."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Text="Nothing in this category yet." FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}" FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
