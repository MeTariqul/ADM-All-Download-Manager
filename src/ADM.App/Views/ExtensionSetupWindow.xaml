<Window x:Class="Adm.App.Views.ExtensionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up your browser extension" Width="700" Height="620"
        MinWidth="620" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Connect your browser" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Set up the ADM extension once to send browser downloads straight to ADM."
                       Margin="0,7,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Extension folder" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Choose this folder when your browser asks where the unpacked extension is."
                                   Margin="0,5,0,12" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="FolderPathBox" Style="{StaticResource InputBox}" IsReadOnly="True"
                                 IsTabStop="True" ToolTip="Full path to the ADM browser extension folder" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Copy path" Style="{StaticResource PrimaryButton}"
                                    Click="CopyPath_Click" />
                            <Button Content="Open folder" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="OpenFolder_Click" />
                        </StackPanel>
                        <TextBlock x:Name="FolderStatusText" Margin="0,10,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Chrome, Edge, or Brave" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="1. Open the browser extensions page: " />
                            <Run Text="chrome://extensions" FontWeight="SemiBold" />
                            <Run Text=" (Edge: " />
                            <Run Text="edge://extensions" FontWeight="SemiBold" />
                            <Run Text=").&#x0a;2. Turn on Developer mode, then choose Load unpacked.&#x0a;3. Select the extension folder shown above." />
                        </TextBlock>
                        <TextBlock Text="Firefox setup uses a temporary add-on. Open the full guide for those steps."
                                   Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="Open full setup guide" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenGuide_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Done" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" IsDefault="True" Click="Done_Click" />
    </Grid>
</Window>
