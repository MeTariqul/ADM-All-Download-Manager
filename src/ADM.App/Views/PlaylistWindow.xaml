<Window x:Class="Adm.App.Views.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download playlist"
        Width="620" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Window.Resources>
        <Style x:Key="EntryItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                                Padding="10,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Download playlist" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="TitleText" Text="Reading playlist..."
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" />
            <TextBlock x:Name="SourceText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,8">
            <Button Content="Select all" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnSelectAll" />
            <Button Content="Select none" Style="{StaticResource GhostButton}" Click="OnSelectNone" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <ListBox x:Name="EntryList" Style="{StaticResource DownloadList}"
                         ItemContainerStyle="{StaticResource EntryItem}"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="14,0,6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="LoadingPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Reading the playlist..." FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="This usually takes a few seconds." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Could not read this playlist" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    <Button Content="Try again" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                            Margin="0,18,0,0" Click="OnRetry" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="FolderText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"
                        Padding="20,9" Margin="0,0,10,0" />
                <Button x:Name="DownloadButton" Content="Download selected" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Padding="24,9" IsEnabled="False" Click="OnDownload" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
