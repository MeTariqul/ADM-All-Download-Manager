<Window x:Class="Adm.App.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate ADM"
        Width="520" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Activate ADM" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Enter the licence key you received with your copy of ADM."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="LICENCE KEY" Style="{StaticResource SectionLabel}" />
            <TextBox x:Name="KeyBox" Style="{StaticResource InputBox}" Margin="0,10,0,0"
                     FontSize="13" KeyDown="OnKeyDown" />

            <Button x:Name="ActivateButton" Content="Activate" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Margin="0,14,0,0" Padding="26,10" Click="OnActivate" />

            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0" />

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0"
                    x:Name="AppKeyWarning" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="AppKeyWarningText" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <Expander x:Name="AppKeyExpander" Margin="0,10,0,0">
                        <Expander.Header>
                            <TextBlock Text="Set the app key" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Expander.Header>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Text="The app key identifies this build to the licence server. It is kept in appkey.txt next to the executable." />
                            <TextBox x:Name="AppKeyBox" Style="{StaticResource InputBox}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                        Click="OnSaveAppKey" />
                                <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Padding="16,7" Click="OnResetAppKey" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="This device" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="ExpiryText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Device id" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,12,0,0" />
                    <TextBlock x:Name="ShortIdText" FontSize="13" FontFamily="Consolas" Margin="0,4,0,0" />
                    <TextBlock x:Name="DeviceIdText" FontSize="9.5" FontFamily="Consolas"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />

                    <Button Content="Copy device id" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"
                            Click="OnCopyDeviceId" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,18,0,0">
                The device id identifies this computer. It is derived from a Windows identifier and
                hashed, so it cannot be traced back to the machine.
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Get a licence" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                    Click="OnOpenWebsite" />
            <Button Content="Close" Style="{StaticResource GhostButton}" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
