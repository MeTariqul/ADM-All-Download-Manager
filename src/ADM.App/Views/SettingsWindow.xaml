<Window x:Class="Adm.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="620" Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="New downloads use these preferences." FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <TextBlock Text="DOWNLOADS" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Download folder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource InputBox}" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="OnBrowse" />
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Connections per download" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="ConnectionsBox" Style="{StaticResource InputBox}" Width="110"
                                 HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Simultaneous downloads" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="ConcurrentBox" Style="{StaticResource InputBox}" Width="110"
                                 HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Speed limit (KB/s, 0 = unlimited)" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="SpeedLimitBox" Style="{StaticResource InputBox}" Width="180"
                         HorizontalAlignment="Left" />

                <CheckBox x:Name="AskBeforeDownloadCheck" Style="{StaticResource MinimalCheckBox}"
                          Margin="0,16,0,0" Content="Ask before downloads without saved file type preferences" />
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="File type preferences" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="SavedTypesText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,8" />
                        <Button Content="Clear saved file type preferences" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Padding="12,6" Click="OnClearTypePreferences" />
                    </StackPanel>
                </Border>

                <TextBlock Text="When the same link is added twice" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <ComboBox x:Name="DuplicatePolicyBox" Style="{StaticResource InputComboBox}" Width="240"
                          HorizontalAlignment="Left" />

                <TextBlock Text="When the file already exists" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <ComboBox x:Name="FileExistsPolicyBox" Style="{StaticResource InputComboBox}" Width="240"
                          HorizontalAlignment="Left" />

                <TextBlock Text="When a download fails" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RetryPolicyBox" Style="{StaticResource InputComboBox}" Width="240"
                              HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Retries" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="MaxRetriesBox" Style="{StaticResource InputBox}" Width="80" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,20" />

                <TextBlock Text="SCHEDULE" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Queued downloads wait until the start time, and active downloads are paused at the stop time."
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,10" />

                <CheckBox x:Name="StartTimeCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,6,0,0"
                          Content="Start queued downloads at" />
                <TextBox x:Name="StartTimeBox" Style="{StaticResource InputBox}" Width="110"
                         HorizontalAlignment="Left" Margin="22,8,0,0" />

                <CheckBox x:Name="StopTimeCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,16,0,0"
                          Content="Pause active downloads at" />
                <TextBox x:Name="StopTimeBox" Style="{StaticResource InputBox}" Width="110"
                         HorizontalAlignment="Left" Margin="22,8,0,0" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,20" />

                <TextBlock Text="NETWORK" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Proxy server" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,6" />
                <TextBox x:Name="ProxyBox" Style="{StaticResource InputBox}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Proxy user" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="ProxyUserBox" Style="{StaticResource InputBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Proxy password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="ProxyPasswordBox" Style="{StaticResource InputBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="HTTP basic authentication" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="User name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="AuthUserBox" Style="{StaticResource InputBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="AuthPasswordBox" Style="{StaticResource InputBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Cookie header sent with every request" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="CookieBox" Style="{StaticResource InputBox}" />

                <TextBlock Text="Browser cookies for yt-dlp (chrome, edge, firefox, brave, ...)"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="CookiesBrowserBox" Style="{StaticResource InputBox}" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,20" />

                <TextBlock Text="VIDEO" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Audio bitrate for MP3 (kbps)" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,6" />
                <TextBox x:Name="AudioBitrateBox" Style="{StaticResource InputBox}" Width="120"
                         HorizontalAlignment="Left" />

                <TextBlock Text="Subtitle languages (comma separated)" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="SubtitleLanguagesBox" Style="{StaticResource InputBox}" Width="180"
                         HorizontalAlignment="Left" />

                <CheckBox x:Name="SubtitlesCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,16,0,0"
                          Content="Download and embed subtitles" />
                <CheckBox x:Name="AllowPlaylistsCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Allow downloading whole playlists" />
                <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Check the video engine for updates on startup" />

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="App updates" FontSize="12" FontWeight="SemiBold" />
                        <CheckBox x:Name="AutoUpdateAppCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,8,0,0"
                                  Content="Check for a newer ADM release in the background" />
                        <TextBlock Text="ADM checks for updates every hour and downloads the installer automatically."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <CheckBox x:Name="AutoInstallAppUpdatesCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,10,0,0"
                                  Content="Install newer releases without asking (downloads the installer)" />
                        <TextBlock x:Name="AppUpdateFeedText" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="Check for updates now" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,7"
                                Click="OnCheckAppUpdate" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Video engine" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="VideoEngineText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Button x:Name="UpdateYtDlpButton" Content="Update yt-dlp now" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,7" Click="OnUpdateYtDlp" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,20" />

                <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}" />
                <CheckBox x:Name="AutoResumeCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,14,0,0"
                          Content="Resume unfinished downloads when ADM starts" />
                <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Start ADM with Windows" />
                <CheckBox x:Name="StartInTrayCheck" Style="{StaticResource MinimalCheckBox}" Margin="24,8,0,0"
                          Content="Start in the system tray without opening the window" />
                <CheckBox x:Name="ConfirmDeleteCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Ask before deleting downloaded files" />
                <CheckBox x:Name="NotifyCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Notify me when a download finishes" />
                <CheckBox x:Name="ClipboardCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Watch the clipboard for links" />
                <CheckBox x:Name="DiskSpaceCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Check free disk space before downloading" />
                <CheckBox x:Name="OpenWhenFinishedCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Open the file when the download finishes" />
                <CheckBox x:Name="ExitWhenFinishedCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Quit ADM when every download has finished" />
                <CheckBox x:Name="LogFileCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Write a diagnostics log file" />
                <CheckBox x:Name="InterceptCheck" Style="{StaticResource MinimalCheckBox}" Margin="0,12,0,0"
                          Content="Let the browser extension hand downloads to ADM" />

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Browser integration" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Install the ADM browser extension to catch downloads and media from Chrome, Edge and Firefox. The extension talks to ADM through the native messaging host installed with the app."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Licence" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="LicenseText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Manage licence" Style="{StaticResource GhostButton}"
                                    Padding="14,7" Click="OnManageLicense" />
                            <Button Content="Copy device id" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Padding="14,7" Click="OnCopyDeviceId" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="About ADM" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Created by Tariqul Islam" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="GitHub" Style="{StaticResource GhostButton}" Padding="14,7"
                                    Click="OnOpenGitHub" />
                            <Button Content="LinkedIn" Style="{StaticResource GhostButton}" Padding="14,7"
                                    Margin="8,0,0,0" Click="OnOpenLinkedIn" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"
                    Padding="20,9" Margin="0,0,10,0" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Padding="24,9" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
