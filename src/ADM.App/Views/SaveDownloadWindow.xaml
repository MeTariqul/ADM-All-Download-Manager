<Window x:Class="Adm.App.Views.SaveDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review download" Width="620" Height="680" MinWidth="540" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Review before downloading" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="UrlText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="FILE NAME" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="FileNameBox" Style="{StaticResource InputBox}" Margin="0,8,0,0" />

                <TextBlock Text="SAVE LOCATION" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource InputBox}" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="TRANSFER DETAILS" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Connections (1–32)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="ConnectionsBox" Style="{StaticResource InputBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Speed cap (KB/s, 0 = unlimited)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="SpeedLimitBox" Style="{StaticResource InputBox}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Expected checksum (optional)" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChecksumBox" Style="{StaticResource InputBox}" />
                            <ComboBox x:Name="ChecksumAlgorithmBox" Grid.Column="1"
                                      Style="{StaticResource InputComboBox}" Width="105" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="RememberCheck" Style="{StaticResource MinimalCheckBox}"
                          Margin="0,18,0,0" Content="Remember this folder and transfer setup for this file type, and skip this prompt next time" />
                <TextBlock x:Name="TypeText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="24,5,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"
                    Padding="20,9" Margin="0,0,10,0" />
            <Button Content="Start download" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Padding="20,9" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>
