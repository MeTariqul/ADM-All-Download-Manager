<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Only the brush keys are overridden; the styles in
         Minimal.xaml keep working because they reference the brushes. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16181D" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#16181D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2127" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262A31" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2C3038" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#333842" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E333B" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A1D22" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C8CCD2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A2A9B4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#767D88" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E5A54B" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#16181D" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2E333B" />

</ResourceDictionary>
